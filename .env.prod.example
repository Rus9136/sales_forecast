# === Database ===
POSTGRES_USER=sales_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=sales_forecast

# === Application ===
DATABASE_URL=postgresql://sales_user:CHANGE_ME_STRONG_PASSWORD@sales-forecast-db:5432/sales_forecast
API_BASE_URL=http://tco.aqnietgroup.com:5555/v1
API_TOKEN=CHANGE_ME_YOUR_API_TOKEN
DEBUG=False

# === iiko Integration ===
IIKO_LOGIN=CHANGE_ME
IIKO_PASSWORD=CHANGE_ME

# === CORS ===
ALLOWED_ORIGINS=https://aqniet.site

# === UI Auth bootstrap ===
# Phone of the first admin user. Created on startup if no admin exists yet.
# Format: any digits (auto-normalized). Example: +7 (700) 123-45-67
BOOTSTRAP_ADMIN_PHONE=
BOOTSTRAP_ADMIN_NAME=Администратор

# === iiko Domains ===
IIKO_DOMAINS=https://sandy-co-co.iiko.it,https://madlen-group-so.iiko.it

# === AI Recommendations ===
# At minimum, set ANTHROPIC_API_KEY for the AI Recommendations feature.
# ANTHROPIC_API_KEY_* are optional per-agent isolated keys (fall back to ANTHROPIC_API_KEY).
ANTHROPIC_API_KEY=
ANTHROPIC_API_KEY_PAYROLL=
ANTHROPIC_API_KEY_STAFFING=
ANTHROPIC_API_KEY_NARRATIVE=
ANTHROPIC_API_KEY_REPUTATION=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
CLAUDE_MODEL=claude-sonnet-4-20250514
# OpenRouter (https://openrouter.ai) — OpenAI-compatible gateway to many models.
# Model slug format: vendor/model, e.g. anthropic/claude-sonnet-4.6
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4.6
# Default provider for background LLM jobs and UI requests without explicit provider:
# claude | openai | openrouter | gemini
AI_DEFAULT_PROVIDER=claude
