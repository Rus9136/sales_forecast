# === Database ===
POSTGRES_USER=sales_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=sales_forecast

# === Application ===
DATABASE_URL=postgresql://sales_user:CHANGE_ME_STRONG_PASSWORD@sales-forecast-db:5432/sales_forecast
API_BASE_URL=http://tco.aqnietgroup.com:5555/v1
API_TOKEN=CHANGE_ME_YOUR_API_TOKEN
DEBUG=False

# === iiko Integration ===
IIKO_LOGIN=CHANGE_ME
IIKO_PASSWORD=CHANGE_ME

# === CORS ===
ALLOWED_ORIGINS=https://aqniet.site

# === UI Auth bootstrap ===
# Phone of the first admin user. Created on startup if no admin exists yet.
# Format: any digits (auto-normalized). Example: +7 (700) 123-45-67
BOOTSTRAP_ADMIN_PHONE=
BOOTSTRAP_ADMIN_NAME=Администратор

# === iiko Domains ===
IIKO_DOMAINS=https://sandy-co-co.iiko.it,https://madlen-group-so.iiko.it

# === AI Recommendations ===
# At minimum, set ANTHROPIC_API_KEY for the AI Recommendations feature.
# ANTHROPIC_API_KEY_* are optional per-agent isolated keys (fall back to ANTHROPIC_API_KEY).
ANTHROPIC_API_KEY=
ANTHROPIC_API_KEY_PAYROLL=
ANTHROPIC_API_KEY_STAFFING=
ANTHROPIC_API_KEY_NARRATIVE=
ANTHROPIC_API_KEY_REPUTATION=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
CLAUDE_MODEL=claude-sonnet-4-20250514
# OpenRouter (https://openrouter.ai) — OpenAI-compatible gateway to many models.
# Model slug format: vendor/model, e.g. anthropic/claude-sonnet-4.6
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4.6
# Default provider for background LLM jobs and UI requests without explicit provider:
# claude | openai | openrouter | gemini
AI_DEFAULT_PROVIDER=claude

# ML: deployment decision автопереобучения (аудит P0-3, Фаза 1.2)
RETRAIN_HOLDOUT_DAYS=28
RETRAIN_MEDAPE_TOLERANCE_PCT=10.0

# Алерты мониторинга в Telegram (аудит P0-6, Фаза 1.5)
# Бот через @BotFather; chat_id — id чата/группы для алертов
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Складской контур: точки для ежедневной загрузки списаний/накладных.
# Пусто = вся сеть (десятки МБ XML на недельный срез).
INVENTORY_SYNC_DEPARTMENTS=
INVENTORY_SYNC_LOOKBACK_DAYS=7
# Непродаваемые группы номенклатуры, исключаемые из складского контура (с подгруппами)
INVENTORY_EXCLUDED_GROUPS=

# ── Автовыгрузка утверждённых цен в iiko (приказы menuChange) ──────
# Kill-switch: False → эндпоинты /price-orders отвечают 503
IIKO_PRICE_PUSH_ENABLED=False
# Белый список точек (CSV UUID). Пусто = все точки
IIKO_PRICE_PUSH_DEPARTMENTS=
# NEW — приказ приходит черновиком (пилотный режим), PROCESSED — цена встаёт сама
IIKO_PRICE_ORDER_STATUS=NEW
IIKO_PRICE_ORDER_MAX_ITEMS=40
IIKO_PRICE_ORDER_MAX_LEAD_DAYS=14
