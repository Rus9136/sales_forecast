# === Application ===
PROJECT_NAME=Sales Forecast API
VERSION=0.1.0
DEBUG=True
API_TOKEN=CHANGE_ME_YOUR_API_TOKEN

# === Database ===
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sales_forecast
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=sales_forecast
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# === External API ===
API_BASE_URL=http://tco.aqnietgroup.com:5555/v1

# === iiko Integration ===
IIKO_LOGIN=CHANGE_ME
IIKO_PASSWORD=CHANGE_ME
IIKO_DOMAINS=https://sandy-co-co.iiko.it,https://madlen-group-so.iiko.it

# === CORS ===
ALLOWED_ORIGINS=http://localhost:8002,http://localhost:3000

# === AI Recommendations ===
# At minimum, set ANTHROPIC_API_KEY. The other ANTHROPIC_API_KEY_* keys are
# optional — when missing, agents fall back to ANTHROPIC_API_KEY.
ANTHROPIC_API_KEY=
ANTHROPIC_API_KEY_PAYROLL=
ANTHROPIC_API_KEY_STAFFING=
ANTHROPIC_API_KEY_NARRATIVE=
ANTHROPIC_API_KEY_REPUTATION=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
CLAUDE_MODEL=claude-sonnet-4-20250514
# OpenRouter (https://openrouter.ai) — OpenAI-compatible gateway to many models.
# Model slug format: vendor/model, e.g. anthropic/claude-sonnet-4.6
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4.6
# Default provider for background LLM jobs and UI requests without explicit provider:
# claude | openai | openrouter | gemini
AI_DEFAULT_PROVIDER=claude